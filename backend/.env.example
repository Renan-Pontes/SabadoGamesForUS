# Configuração de produção do backend (api.sabadogames.app).
# Copie para .env NO SERVIDOR — este arquivo é só um modelo e o .env
# nunca entra no git.

DJANGO_ENV=production
DJANGO_DEBUG=false

# Gere uma chave nova e única:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-uma-chave-unica

DJANGO_ALLOWED_HOSTS=api.sabadogames.app

# O frontend na Vercel. Sem isso o navegador bloqueia as chamadas.
CORS_ALLOWED_ORIGINS=https://sabadogames.app,https://www.sabadogames.app
CSRF_TRUSTED_ORIGINS=https://sabadogames.app,https://www.sabadogames.app,https://api.sabadogames.app

# O PythonAnywhere já faz o redirecionamento para HTTPS na borda ("Force HTTPS"),
# então deixar o Django redirecionar de novo causa laço de redirecionamento.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_HSTS_PRELOAD=true

# Sem DATABASE_URL o projeto usa SQLite em backend/db.sqlite3, que é o
# suficiente para uma mesa de amigos. Para Postgres:
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
