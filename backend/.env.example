# Configuração de produção do backend (sabadogames.pythonanywhere.com).
# Copie para .env NO SERVIDOR — este arquivo é só um modelo e o .env
# nunca entra no git.

DJANGO_ENV=production
DJANGO_DEBUG=false

# Gere uma chave nova e única:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-uma-chave-unica

DJANGO_ALLOWED_HOSTS=sabadogames.pythonanywhere.com

# Mesa de amigos: qualquer origem pode chamar a API, o que inclui os previews
# da Vercel. Para travar no domínio oficial, troque por
#   CORS_ALLOWED_ORIGINS=https://sabadogames.app,https://www.sabadogames.app
CORS_ALLOW_ALL_ORIGINS=true
CSRF_TRUSTED_ORIGINS=https://sabadogames.app,https://www.sabadogames.app,https://sabadogames.pythonanywhere.com

# O PythonAnywhere já faz o redirecionamento para HTTPS na borda ("Force HTTPS"),
# então deixar o Django redirecionar de novo causa laço de redirecionamento.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
# HSTS desligado: o domínio é do PythonAnywhere, não nosso.
DJANGO_HSTS_SECONDS=0

# Sem DATABASE_URL o projeto usa SQLite em backend/db.sqlite3, que é o
# suficiente para uma mesa de amigos. Para Postgres:
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
